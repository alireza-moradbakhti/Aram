# Local secrets for tooling and release builds.
# Copy this file to `.env` and fill in values locally.
# `.env` is gitignored — never commit it, never paste its contents into a chat or screenshot.

# ---------------------------------------------------------------------------
# GitHub (optional)
# ---------------------------------------------------------------------------
# GitHub CLI authentication is stored securely by `gh auth login` in the OS
# credential manager. You normally do NOT need a token here.
# Only set this if you deliberately choose a fine-grained PAT with the
# repository and project scopes.
# GH_TOKEN=

# ---------------------------------------------------------------------------
# Android release signing (used from milestone M4 onward)
# ---------------------------------------------------------------------------
# ARAM_KEYSTORE_PATH=C:/keys/aram-release.jks
# ARAM_KEYSTORE_PASSWORD=
# ARAM_KEY_ALIAS=aram
# ARAM_KEY_PASSWORD=
